# OpenWordCode local Core configuration.
# Copy this file to `.env` for local development. `.env` is ignored by Git.
OPENWORDCODE_PORT=10200
OPENWORDCODE_DATA_DIR=

# Optional fixed local session token. Leave blank to generate one per Core process.
OPENWORDCODE_SESSION_TOKEN=

# First-party local compatibility gateway (started with Core).
OPENWORDCODE_BRIDGE_PORT=10101
# Optional: pin the gateway to one configured account provider.
OPENWORDCODE_BRIDGE_PROVIDER_ID=
# Optional: require this token on local /v1 bridge requests.
OPENWORDCODE_BRIDGE_TOKEN=

# Optional: set this only when Codex CLI uses a non-default home. It must match
# the CODEX_HOME used by the user's `codex login` session.
# CODEX_HOME=
# Optional: set this when the Codex executable is not discoverable. On Windows
# OpenWordCode also searches the per-user OpenAI Codex installation automatically.
# CODEX_CLI_PATH=

# The public Word add-in does not expose API-key entry. Use the OpenWordCode
# Bridge or a supported OAuth/CLI account connector instead.
# Existing Core deployments may still resolve legacy environment credentials,
# but do not add real secrets to this file or commit them to GitHub.

# OpenWordCode account sign-in configuration.
# Leave blank until you have an OAuth client registration owned by your app.
OPENWORDCODE_OPENAI_OAUTH_CLIENT_ID=
OPENWORDCODE_OPENAI_OAUTH_REDIRECT_URI=http://localhost:10200/oauth/chatgpt/callback

# Optional CLI executable overrides for the provider-owned local-session
# connectors. Leave blank when the official commands are already on PATH.
# CLAUDE_CLI_PATH=
# KIMI_CLI_PATH=
# ANTIGRAVITY_CLI_PATH=
# CLAUDE_CONFIG_DIR=
# KIMI_SHARE_DIR=
# Optional explicit Antigravity credential source for controlled test setups.
# ANTIGRAVITY_CREDENTIALS_PATH=

# Optional provider-endpoint overrides for an approved OAuth-compatible setup.
# OPENWORDCODE_OPENAI_OAUTH_AUTHORIZE_URL=https://auth.openai.com/oauth/authorize
# OPENWORDCODE_OPENAI_OAUTH_TOKEN_URL=https://auth.openai.com/oauth/token
# OPENWORDCODE_OPENAI_OAUTH_SCOPE=openid profile email offline_access

# Optional Google Antigravity public-client overrides. Leave blank to use the
# bundled installed-app registration. Never put user tokens in this file.
GOOGLE_ANTIGRAVITY_CLIENT_ID=
GOOGLE_ANTIGRAVITY_CLIENT_SECRET=
