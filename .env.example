# OpenWordCode local Core configuration.
# Copy this file to `.env` for local development. `.env` is ignored by Git.
OPENWORDCODE_PORT=10200
OPENWORDCODE_DATA_DIR=

# Optional fixed local session token. Leave blank to generate one per Core process.
OPENWORDCODE_SESSION_TOKEN=

# First-party local compatibility gateway (started with Core).
OPENWORDCODE_BRIDGE_PORT=10101
# Optional: pin the gateway to one configured provider, for example `demo` or `openai`.
OPENWORDCODE_BRIDGE_PROVIDER_ID=
# Optional: require this token on local /v1 bridge requests.
OPENWORDCODE_BRIDGE_TOKEN=

# Direct provider API keys. Prefer environment variables or the in-app encrypted
# credential store. Never commit real values to GitHub.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
OPENROUTER_API_KEY=
GEMINI_API_KEY=
XAI_API_KEY=
MOONSHOT_API_KEY=

# OpenWordCode account sign-in configuration.
# Leave blank until you have an OAuth client registration owned by your app.
OPENWORDCODE_OPENAI_OAUTH_CLIENT_ID=
OPENWORDCODE_OPENAI_OAUTH_REDIRECT_URI=http://localhost:10200/oauth/chatgpt/callback

# Optional provider-endpoint overrides for an approved OAuth-compatible setup.
# OPENWORDCODE_OPENAI_OAUTH_AUTHORIZE_URL=https://auth.openai.com/oauth/authorize
# OPENWORDCODE_OPENAI_OAUTH_TOKEN_URL=https://auth.openai.com/oauth/token
# OPENWORDCODE_OPENAI_OAUTH_SCOPE=openid profile email offline_access

# Google Antigravity OAuth. The client ID may use the built-in public client,
# but this build requires the provider-approved client secret at sign-in time.
# Never commit the secret.
GOOGLE_ANTIGRAVITY_CLIENT_ID=
GOOGLE_ANTIGRAVITY_CLIENT_SECRET=
