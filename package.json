{
  "name": "openwordcode",
  "version": "0.1.0",
  "private": true,
  "description": "Open AI agents for Microsoft Word.",
  "author": "Liko",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/LikoKiko/OpenWordCode.git"
  },
  "homepage": "https://github.com/LikoKiko/OpenWordCode#readme",
  "bugs": {
    "url": "https://github.com/LikoKiko/OpenWordCode/issues"
  },
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "concurrently -k \"npm:dev:core\" \"npm:dev:addin\"",
    "dev:core": "tsx apps/core/src/cli.ts start",
    "dev:addin": "vite --config apps/word-addin/vite.config.ts",
    "start": "tsx apps/core/src/cli.ts start",
    "status": "tsx apps/core/src/cli.ts status",
    "doctor": "tsx apps/core/src/cli.ts doctor",
    "providers": "tsx apps/core/src/cli.ts providers",
    "models": "tsx apps/core/src/cli.ts models",
    "cert:install": "npx office-addin-dev-certs install --days 365",
    "cert:verify": "npx office-addin-dev-certs verify",
    "build": "npm run typecheck && vite build --config apps/word-addin/vite.config.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "sideload": "npx office-addin-debugging start apps/word-addin/public/manifest.xml desktop --app word --no-debug --no-live-reload",
    "unsideload": "npx office-addin-debugging stop apps/word-addin/public/manifest.xml desktop"
  },
  "dependencies": {
    "@fastify/cors": "^10.0.2",
    "@fastify/static": "^10.1.3",
    "@phosphor-icons/react": "^2.1.10",
    "fastify": "^5.2.1",
    "notyf": "^3.10.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/node": "^22.13.4",
    "@types/office-js": "^1.0.501",
    "@types/react": "^19.0.8",
    "@types/react-dom": "^19.0.3",
    "@vitejs/plugin-basic-ssl": "^2.0.0",
    "@vitejs/plugin-react": "^4.4.1",
    "concurrently": "^9.1.2",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3",
    "vite": "^6.1.0",
    "vitest": "^3.0.5"
  }
}
